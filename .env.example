# Copy to .env.local and fill in values.
# The site runs in local JSON mode without these.
# Production needs them for login, persistence, and image uploads.

# Admin login at /admin
ADMIN_PASSWORD=change-me-now
# Sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=please-generate-a-long-random-string

# Supabase (required in production)
# Settings → API in the Supabase project
SUPABASE_URL=
# service_role key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=balloons-media

# Public site URL used for sitemap, robots, and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
