# ──────────────────────────────────────────────────────────────
#  BALLOONS FRC — Environment variables
#  Copy this file to ".env.local" and fill in the values.
#  The site runs WITHOUT any of these (local JSON demo mode),
#  but you need them for real persistence + image uploads in production.
# ──────────────────────────────────────────────────────────────

# 1) ADMIN LOGIN
# The password for the /admin dashboard. CHANGE THIS before deploying.
ADMIN_PASSWORD=change-me-now

# A long random string used to sign the login cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=please-generate-a-long-random-string

# 2) SUPABASE (database + image storage) — required for production
# Find these in your Supabase project: Settings → API
# Leave blank to run in local JSON demo mode.
SUPABASE_URL=
# The "service_role" key. SERVER-SIDE ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The name of the public Storage bucket you create for uploads (see README).
SUPABASE_BUCKET=balloons-media
